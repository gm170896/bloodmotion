# Wajib: password login admin (min. 8 karakter)
ADMIN_PASSWORD=ganti-dengan-password-kuat
# Opsional
PORT=3001
# SESSION_SECRET=string-acak-panjang
# DATA_DIR=/path/ke/folder/data   (taruh di disk persisten saat hosting)
# Untuk tombol "Unduh PDF" langsung dari server: path Chrome / Chromium / Edge (otomatis dicari kalau terpasang)
# CHROME_PATH=/usr/bin/google-chrome
# Kalau website di-host di domain lain dari backend, izinkan form pesanan mengirim ke backend:
# ALLOWED_ORIGIN=https://domain-website-kamu.com
